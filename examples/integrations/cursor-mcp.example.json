{
  "mcpServers": {
    "roboros": {
      "command": "pnpm",
      "args": [
        "--dir",
        "/ABSOLUTE/PATH/TO/RoboROS",
        "--filter",
        "@robotflowlabs/adapter-mcp",
        "exec",
        "node",
        "dist/index.js"
      ],
      "env": {
        "RFL_TRANSPORT_MODE": "rosbridge",
        "RFL_ROSBRIDGE_URL": "ws://127.0.0.1:9090",
        "RFL_ROBOT_NAME": "Robot Flow Demo"
      }
    }
  }
}
