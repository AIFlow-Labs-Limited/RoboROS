{
  "name": "@robotflowlabs/adapter-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP adapter for RoboROS by Robot Flow Labs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "roboros-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm --dir ../runtime-core build && tsc -p tsconfig.json",
    "typecheck": "pnpm --dir ../runtime-core build && tsc --noEmit -p tsconfig.json",
    "dev": "pnpm --dir ../runtime-core build && tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@robotflowlabs/runtime-core": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "license": "Apache-2.0"
}
